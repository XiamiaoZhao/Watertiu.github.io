{
  "voice": "zh-CN-XiaoxiaoNeural",
  "totalDuration": 1231.632,
  "tracks": [
    {
      "id": "intro",
      "name": "灵隐开篇 · 从山石走入殿堂",
      "src": "assets/audio/intro.mp3",
      "duration": 145.608,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "4ffcf6e8ab70b0ca78a746d6652e680a5f030d421df6b87169bd2e848abc2eb7",
      "bytes": 873648,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 3.026,
          "text": "欢迎来到灵隐与飞来峰。"
        },
        {
          "start": 2.976,
          "end": 9.728,
          "text": "这里可以从两种材料理解：山上的石头，与寺院中的木构、造像。"
        },
        {
          "start": 9.728,
          "end": 20.177,
          "text": "石刻依附山体，经过长期风雨仍保留古代雕凿痕迹；殿堂则在火灾、重修与扩建中不断更新。"
        },
        {
          "start": 20.177,
          "end": 24.484,
          "text": "两者都承载历史，却有不同的保存方式。"
        },
        {
          "start": 24.484,
          "end": 31.223,
          "text": "今天先沿冷泉溪看飞来峰，再进入灵隐中轴，更容易读清层次。"
        },
        {
          "start": 31.223,
          "end": 35.992,
          "text": "灵隐寺的寺史把创立追溯到东晋僧人慧理。"
        },
        {
          "start": 35.992,
          "end": 47.812,
          "text": "关于他见到山峰，觉得像从天竺飞来，因此留下飞来峰之名的故事，属于寺院传说，不是山体真的飞行过的地质解释。"
        },
        {
          "start": 47.812,
          "end": 58.94,
          "text": "传说表达古人对奇石与佛教圣地的想象；眼前洞穴和岩壁，则需要从自然形成与后世人工雕凿两方面来看。"
        },
        {
          "start": 58.94,
          "end": 66.78,
          "text": "飞来峰保存五代、宋元以来的造像，尤其能看见不同佛教图像传统的相遇。"
        },
        {
          "start": 66.78,
          "end": 70.217,
          "text": "参观不必忙着数完所有佛像。"
        },
        {
          "start": 70.217,
          "end": 82.418,
          "text": "我们挑早期题记、笑口弥勒与沿溪造像三个角度，观察石头怎样通过凿深、留下轮廓与安排姿态，成为可以观看的形象。"
        },
        {
          "start": 82.418,
          "end": 89.348,
          "text": "风化和缺损也是文物经历的一部分，不应为了看清而触摸或拓印。"
        },
        {
          "start": 89.348,
          "end": 94.81,
          "text": "寺院中轴由天王殿、大雄宝殿等逐级向后展开。"
        },
        {
          "start": 94.81,
          "end": 101.128,
          "text": "步入一重院落，屋顶高度、造像尺度与人的速度都会变化。"
        },
        {
          "start": 101.128,
          "end": 109.226,
          "text": "我们分别认识护法、释迦牟尼、药师与华严三圣，把外表相近的殿堂分清。"
        },
        {
          "start": 109.226,
          "end": 115.163,
          "text": "它们不只是拍照背景，仍是僧众和信众使用的宗教空间。"
        },
        {
          "start": 115.163,
          "end": 118.152,
          "text": "今天不要求登完所有山路。"
        },
        {
          "start": 118.152,
          "end": 128.56,
          "text": "先完成溪边与主要殿堂，体力允许再往高处走；华严殿讲解可以坐着听，不必为了集齐站点强行爬阶。"
        },
        {
          "start": 128.56,
          "end": 136.481,
          "text": "戴耳机、调低音量，遇到礼佛、法会和不开放区域就顺着现场引导调整。"
        },
        {
          "start": 136.481,
          "end": 145.516,
          "text": "第一站从飞来峰洞口附近开始：先看石头的天然轮廓，再找其中经过人手安排的一小部分。"
        }
      ]
    },
    {
      "id": "qinglin",
      "name": "青林洞一带 · 在石壁上寻找最早的年代",
      "src": "assets/audio/qinglin.mp3",
      "duration": 150.432,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "aa0a719219ffd8769cf81616f73ce2b8239a1cbcb13cb4cb17c76135e0f20bb1",
      "bytes": 902592,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 7.958,
          "text": "进入飞来峰，先在安全步道上观察山石，不必钻进拥挤或潮湿的狭窄位置。"
        },
        {
          "start": 7.908,
          "end": 13.709,
          "text": "岩体有孔洞、裂隙和凹凸表面，天然形状已很丰富。"
        },
        {
          "start": 13.709,
          "end": 22.527,
          "text": "雕刻者没有把整座山削成平墙，而是选适合位置开龛，使人物与岩壁互相配合。"
        },
        {
          "start": 22.527,
          "end": 28.668,
          "text": "找哪里是自然粗糙，哪里出现规则边缘，你就开始读懂石窟了。"
        },
        {
          "start": 28.668,
          "end": 39.579,
          "text": "青林洞入口附近有一组带后周广顺元年，也就是公元九五一年题记的造像，是飞来峰有明确题记的早期例子。"
        },
        {
          "start": 39.579,
          "end": 50.87,
          "text": "题记不只告诉我们一个数字，常常还与出资者、愿望和营造行为有关，让雕像从单独艺术品回到当时的人与社会。"
        },
        {
          "start": 50.87,
          "end": 61.046,
          "text": "没有题记时，研究者还需结合造型、衣纹和其他资料判断年代，不能只凭颜色深浅猜古老程度。"
        },
        {
          "start": 61.046,
          "end": 68.247,
          "text": "这一带早期造像中的弥陀、观音和大势至等题材，与净土信仰有关。"
        },
        {
          "start": 68.247,
          "end": 76.291,
          "text": "不必当场背出每个名字，更有用的方法是先看主尊与两侧人物怎样组成整体。"
        },
        {
          "start": 76.291,
          "end": 82.106,
          "text": "中央形象提供稳定中心，两侧人物把视线向内收拢。"
        },
        {
          "start": 82.106,
          "end": 91.943,
          "text": "佛龛像浅浅的舞台，又没有彻底脱离山体；背后的石头提醒你，这些形象是从岩壁里逐步凿出来的。"
        },
        {
          "start": 91.943,
          "end": 100.965,
          "text": "留意衣褶：雕刻者把连续布料转成起伏石面，深凹线积下阴影，较平处承接亮光。"
        },
        {
          "start": 100.965,
          "end": 103.886,
          "text": "角度稍变，形体就不同。"
        },
        {
          "start": 103.886,
          "end": 109.932,
          "text": "今天柔和的轮廓，可能既来自原造型，也受长期风化影响。"
        },
        {
          "start": 109.932,
          "end": 116.25,
          "text": "不要为确认手感去摸，油脂和反复摩擦会给石面带来新负担。"
        },
        {
          "start": 116.25,
          "end": 123.261,
          "text": "与观看室内雕塑不同，这里还要把渗水、植物和岩体裂隙考虑进去。"
        },
        {
          "start": 123.261,
          "end": 128.261,
          "text": "洞口比洞内明亮，手机曝光可能把细节压暗。"
        },
        {
          "start": 128.261,
          "end": 134.552,
          "text": "与其开强光贴近拍，不如让眼睛适应，换到不碍通行的位置。"
        },
        {
          "start": 134.552,
          "end": 144.348,
          "text": "看完再比较天然洞穴与佛龛：自然留下材料，人留下观看与信仰秩序，两者共同构成飞来峰。"
        },
        {
          "start": 144.348,
          "end": 150.353,
          "text": "下一段沿溪去看流水、崖壁与亭子怎样形成另一幅画面。"
        }
      ]
    },
    {
      "id": "lengquan",
      "name": "冷泉溪与冷泉亭 · 听水也是读园林",
      "src": "assets/audio/lengquan.mp3",
      "duration": 147.624,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "380838f8ac922188d19a5b2acad125b48d72f7a9d48338dcee0e453de4c84d2b",
      "bytes": 885744,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 5.526,
          "text": "来到冷泉溪，先把耳机稍移开几秒，听真正的水声。"
        },
        {
          "start": 5.476,
          "end": 15.068,
          "text": "水碰到石头，发出不同于平静湖面的声音；树荫与潮湿空气，也使这里和城市街道明显不同。"
        },
        {
          "start": 15.068,
          "end": 24.266,
          "text": "冷泉并非只适合拍匾额的名字，身体感到的凉意、声音与光线，本来就是景观的重要部分。"
        },
        {
          "start": 24.266,
          "end": 31.345,
          "text": "溪流把飞来峰石壁与灵隐寺一侧分开，又通过桥与路将它们相连。"
        },
        {
          "start": 31.345,
          "end": 44.484,
          "text": "在可停留的位置，比较南岸岩壁与北侧寺院：一边是带洞穴、造像的山体，一边是整齐殿堂与院落，中间的水像柔软的过渡带。"
        },
        {
          "start": 44.484,
          "end": 50.258,
          "text": "不登山，也能在溪边读到自然形态与人工秩序的对照。"
        },
        {
          "start": 50.258,
          "end": 57.283,
          "text": "白居易写过冷泉亭，可见这里很早就是人们观看、停留和赞叹的地方。"
        },
        {
          "start": 57.283,
          "end": 65.122,
          "text": "不过今天的亭与岸线经历过变化，不能把眼前建筑不加区别地称为唐代原物。"
        },
        {
          "start": 65.122,
          "end": 69.851,
          "text": "更值得问的是：为什么历代人愿意在这里设亭？"
        },
        {
          "start": 69.851,
          "end": 78.505,
          "text": "亭不需占满空间，只给人一个有遮蔽的落脚点，便把水、山石与树林一起纳入视野。"
        },
        {
          "start": 78.505,
          "end": 81.318,
          "text": "沿溪还能看到元代造像。"
        },
        {
          "start": 81.318,
          "end": 89.443,
          "text": "灵隐管理处对冷泉亭南岸附近佛龛的介绍，指出其中有汉式阿弥陀佛形象。"
        },
        {
          "start": 89.443,
          "end": 100.054,
          "text": "飞来峰特别之处，正在于同一山体里，不同时代、不同样式的作品彼此接近，并非每尊都属同一种风格。"
        },
        {
          "start": 100.054,
          "end": 106.861,
          "text": "判断依赖标牌与研究资料，不宜看见宝冠就匆忙贴上笼统标签。"
        },
        {
          "start": 106.861,
          "end": 113.179,
          "text": "做个小练习：先看水，再看石壁造像，最后看枝条走向。"
        },
        {
          "start": 113.179,
          "end": 119.307,
          "text": "水横向流动，岩壁让目光向上，枝条又把视线伸到远处。"
        },
        {
          "start": 119.307,
          "end": 123.234,
          "text": "园林节奏常由这些方向共同形成。"
        },
        {
          "start": 123.234,
          "end": 131.413,
          "text": "雨后石面可能湿滑，脚下比镜头更重要；不越围栏，也不必拍全每处石刻。"
        },
        {
          "start": 131.413,
          "end": 137.5,
          "text": "试着记住水声里最清楚的一次起伏，再选一尊真正看懂的像。"
        },
        {
          "start": 137.5,
          "end": 142.704,
          "text": "带走声音与细节，比匆忙收集一串照片更丰富。"
        },
        {
          "start": 142.704,
          "end": 147.541,
          "text": "回到主步道，我们继续看那组最有亲切感的笑脸。"
        }
      ]
    },
    {
      "id": "mile",
      "name": "布袋弥勒 · 一张笑脸怎样进入石窟",
      "src": "assets/audio/mile.mp3",
      "duration": 148.608,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "33ad4276c5cc03b42b1e6d967e026e3852b450ed7235abd685ba0e5eb46d6327",
      "bytes": 891648,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 5.689,
          "text": "飞来峰最容易记住的形象之一，是露腹而笑的布袋弥勒。"
        },
        {
          "start": 5.639,
          "end": 11.59,
          "text": "在不挡人的位置，先完整看这组造像，再把视线移向两侧。"
        },
        {
          "start": 11.59,
          "end": 17.595,
          "text": "中央人物体量醒目，面部带笑，周围罗汉则有不同姿态。"
        },
        {
          "start": 17.595,
          "end": 27.296,
          "text": "这不是随意排满人物，而用中心与两侧、坐姿与动作的差异，组织一幅可慢慢读的石上群像。"
        },
        {
          "start": 27.296,
          "end": 33.573,
          "text": "日常的大肚笑佛，并非所有地区、所有时代弥勒的唯一模样。"
        },
        {
          "start": 33.573,
          "end": 42.622,
          "text": "弥勒还可呈现菩萨装等形象；布袋和尚式弥勒，与后世流传的契此和尚故事联系很深。"
        },
        {
          "start": 42.622,
          "end": 48.288,
          "text": "传说把亲切、洒脱、能容人的气质赋予宗教形象。"
        },
        {
          "start": 48.288,
          "end": 56.943,
          "text": "认出笑脸只是第一步，更深一层是看到一种信仰如何在本地文化里获得熟悉面孔。"
        },
        {
          "start": 56.943,
          "end": 63.111,
          "text": "看工艺，可以先看肚腹的大曲面，再看手指、衣缘和嘴角。"
        },
        {
          "start": 63.111,
          "end": 69.266,
          "text": "圆润大面形成明暗渐变，小而深的刻线制造清楚阴影。"
        },
        {
          "start": 69.266,
          "end": 75.516,
          "text": "两种处理放在一起，形象便既有整体安稳，也有生动表情。"
        },
        {
          "start": 75.516,
          "end": 85.788,
          "text": "与可移动木雕相比，摩崖造像还受岩石厚度和裂隙限制，雕刻者必须在材料允许范围里安排身体。"
        },
        {
          "start": 85.788,
          "end": 93.872,
          "text": "再看周围罗汉：有人转头，有人收拢肢体，有人的衣纹把动作延伸到身体之外。"
        },
        {
          "start": 93.872,
          "end": 100.408,
          "text": "群像趣味不只在脸是否不同，还在人物之间形成怎样的呼应。"
        },
        {
          "start": 100.408,
          "end": 106.671,
          "text": "任选两尊，比肩膀高低和头部方向，不必一次辨全姓名。"
        },
        {
          "start": 106.671,
          "end": 114.117,
          "text": "对于没有明确标识的细节，我们保留疑问，不凭想象编成确定的个人故事。"
        },
        {
          "start": 114.117,
          "end": 120.625,
          "text": "石面受到自然风化与长期保护措施影响，现场也可能有围护。"
        },
        {
          "start": 120.625,
          "end": 126.495,
          "text": "请不要把摸肚子、摸手等流行做法当成必须完成的习俗。"
        },
        {
          "start": 126.495,
          "end": 130.503,
          "text": "耐心观看才是真正接近作品的方法。"
        },
        {
          "start": 130.503,
          "end": 138.356,
          "text": "稍微换个角度，看看笑容是否随着阴影改变，就能体会雕刻留下的微妙空间。"
        },
        {
          "start": 138.356,
          "end": 148.533,
          "text": "离开后进入天王殿，还会见到与弥勒相关的形象；它所在的位置，与护法的关系，又将带来不同感受。"
        }
      ]
    },
    {
      "id": "tianwang",
      "name": "天王殿 · 从云林禅寺读进入口",
      "src": "assets/audio/tianwang.mp3",
      "duration": 177.072,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "6f6b79def57ccc7ee4f75bf95b6df2562b7befcbf33ecc8be9f21193c4b7ac5b",
      "bytes": 1062432,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 4.656,
          "text": "站在天王殿前，抬头看云林禅寺四个字。"
        },
        {
          "start": 4.606,
          "end": 9.226,
          "text": "为什么我们叫它灵隐寺，匾上却写另一寺名？"
        },
        {
          "start": 9.226,
          "end": 14.905,
          "text": "寺方记载，一六八九年康熙南巡时赐名云林禅寺。"
        },
        {
          "start": 14.905,
          "end": 21.236,
          "text": "更早的灵隐旧称没有因此消失，两种名称在后来共同流传。"
        },
        {
          "start": 21.236,
          "end": 28.437,
          "text": "这块匾所连接的，是清代帝王巡游与寺院历史，不只是给游客看的装饰。"
        },
        {
          "start": 28.437,
          "end": 37.84,
          "text": "关于赐名，民间还有故事说，康熙写灵字时把雨头写得太大，来不及写完，于是改成云林。"
        },
        {
          "start": 37.84,
          "end": 46.264,
          "text": "这样的说法流传很广，却属于解释匾额的趣谈；我们没有据此断言帝王当时怎样落笔。"
        },
        {
          "start": 46.264,
          "end": 56.712,
          "text": "可核对的史实是南巡赐额，而眼前的云林二字，又与寺院背山面溪、常有林间云气的环境相互呼应。"
        },
        {
          "start": 56.712,
          "end": 67.527,
          "text": "殿正中是布袋和尚式的弥勒，笑容迎向进入的人；背面面朝山上、也就是大雄宝殿方向的，是护法韦驮。"
        },
        {
          "start": 67.527,
          "end": 79.701,
          "text": "这里有一件很值得慢看的具体文物：寺方资料介绍，韦驮像高约二点五米，以整块香樟木雕成，并将其年代联系到南宋。"
        },
        {
          "start": 79.701,
          "end": 89.062,
          "text": "这意味着我们看到的不只是一般护法形象，也是一件经过寺院漫长变迁保存下来的早期木雕。"
        },
        {
          "start": 89.062,
          "end": 92.405,
          "text": "看木雕，可以先找身体的重心。"
        },
        {
          "start": 92.405,
          "end": 103.899,
          "text": "武将站姿需要显得有力，肩、肘与腿部却不能僵成一根柱子；铠甲层叠与衣带转折，把结构变成了可见节奏。"
        },
        {
          "start": 103.899,
          "end": 115.802,
          "text": "整木雕刻不像拼接大像那样自由，原木的体量与纹理都构成限制，手臂和法器等向外伸出的部分尤其需要处理稳固。"
        },
        {
          "start": 115.802,
          "end": 122.011,
          "text": "表面装饰使它庄严，而内在体势使它站得住、看得活。"
        },
        {
          "start": 122.011,
          "end": 126.236,
          "text": "两侧四大天王则把守护扩展到四方。"
        },
        {
          "start": 126.236,
          "end": 132.69,
          "text": "可以先比较法器与动作，再读现场名称，不急着背完所有配对。"
        },
        {
          "start": 132.69,
          "end": 142.663,
          "text": "铠甲纹样容易吸引眼睛，但更值得看的是人物怎样用扭头、屈肘与身体转向形成不同气势。"
        },
        {
          "start": 142.663,
          "end": 151.033,
          "text": "中央弥勒的亲和、韦驮的警觉与天王的威严，共同组织了进入寺院后的情绪转换。"
        },
        {
          "start": 151.033,
          "end": 158.207,
          "text": "走出殿后再回头，檐口、柱列与门洞会把这些形象重新包进建筑。"
        },
        {
          "start": 158.207,
          "end": 167.351,
          "text": "殿宇曾反复修建，木像却可能保留更早年代；同一个空间里，建筑与文物的年龄并不一致。"
        },
        {
          "start": 167.351,
          "end": 176.97,
          "text": "把这层区别记住，下一座大雄宝殿的近现代樟木巨像，会与这里的早期韦驮形成很有意思的比较。"
        }
      ]
    },
    {
      "id": "daxiong",
      "name": "大雄宝殿 · 樟木巨像与一座殿的尺度",
      "src": "assets/audio/daxiong.mp3",
      "duration": 151.128,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "4d75fcf8a85fc4b45384e293fd3f9e31b07e3388d321c8d8d4e83265da30afe2",
      "bytes": 906768,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 5.281,
          "text": "进入大雄宝殿前，先在庭院稍远处看完整屋顶。"
        },
        {
          "start": 5.231,
          "end": 12.147,
          "text": "檐口层层展开，角部向上挑起，使很大体量不至于像沉重的墙。"
        },
        {
          "start": 12.147,
          "end": 25.285,
          "text": "寺院公布殿高三十三点六米，但数字只告诉大小；真正让人感到庄严的，是柱列、檐口、台基与人的尺度一起形成的关系。"
        },
        {
          "start": 25.285,
          "end": 29.783,
          "text": "走近再看，刚才整体就被许多细节替代。"
        },
        {
          "start": 29.783,
          "end": 32.867,
          "text": "殿中主尊是释迦牟尼佛。"
        },
        {
          "start": 32.867,
          "end": 43.859,
          "text": "大型樟木造像与一九五三年修复灵隐时的创制有关，参考唐代佛教雕塑风格，由多块樟木雕刻镶接而成。"
        },
        {
          "start": 43.859,
          "end": 50.068,
          "text": "这里要分清：借鉴唐代风格，不等于这尊像就是唐代遗物。"
        },
        {
          "start": 50.068,
          "end": 59.389,
          "text": "它同样值得欣赏，因为体现近现代修复中艺术设计、传统匠作与大体量制作的协作能力。"
        },
        {
          "start": 59.389,
          "end": 63.723,
          "text": "面对巨像，先看整体姿态，再看面部。"
        },
        {
          "start": 63.723,
          "end": 73.614,
          "text": "头部微向前，身体端坐，衣纹在胸腹和腿部形成弧线，使高大形象仍能与下方的人建立关系。"
        },
        {
          "start": 73.614,
          "end": 84.022,
          "text": "若完全按平视小像的比例放大，从地面看未必自然，所以大型造像须考虑观者位置、光线和距离。"
        },
        {
          "start": 84.022,
          "end": 89.484,
          "text": "即使不知道每个构件怎样连接，也能感到这种观看设计。"
        },
        {
          "start": 89.484,
          "end": 97.174,
          "text": "多块木料组合成巨像，要先解决整体结构，再把接合关系融入统一造型。"
        },
        {
          "start": 97.174,
          "end": 102.88,
          "text": "表层彩绘或金色处理，使不同木块成为连续形象。"
        },
        {
          "start": 102.88,
          "end": 114.198,
          "text": "不需为了找接缝贴近、触摸或进入未开放区域；重要的是工艺如何服务完整视觉，而非把作品拆成材料清单。"
        },
        {
          "start": 114.198,
          "end": 119.307,
          "text": "退回稍远位置，衣纹与面部的关系反而更清楚。"
        },
        {
          "start": 119.307,
          "end": 125.503,
          "text": "殿前还有古老石塔等遗存，与现今主殿不一定属于同一年代。"
        },
        {
          "start": 125.503,
          "end": 131.984,
          "text": "看见统一院落就以为所有东西同时建成，是参观时常见的误会。"
        },
        {
          "start": 131.984,
          "end": 135.842,
          "text": "不同年代恰好可以在同一视野里相遇。"
        },
        {
          "start": 135.842,
          "end": 143.043,
          "text": "出殿再回望，先前让你惊叹的高度，已被面容、衣纹与构造细节填充。"
        },
        {
          "start": 143.043,
          "end": 151.046,
          "text": "接下来的药师殿，会把主题从宏大空间，转向关于健康、光明和照护的愿望。"
        }
      ]
    },
    {
      "id": "yaoshi",
      "name": "药师殿 · 琉璃光中的照护愿望",
      "src": "assets/audio/yaoshi.mp3",
      "duration": 152.016,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "cdb35b8c57755c94cd2c30258137c1612772d95fcc6ebdc4ec5bb5f129341e7c",
      "bytes": 912096,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 4.629,
          "text": "离开大雄宝殿沿中轴向后，来到药师殿。"
        },
        {
          "start": 4.579,
          "end": 10.72,
          "text": "与仰望巨像相比，这里可以把注意力放在造像组合和名称。"
        },
        {
          "start": 10.72,
          "end": 19.28,
          "text": "药师佛全称药师琉璃光如来，在汉传佛教中与离苦、安稳与健康愿望相联系。"
        },
        {
          "start": 19.28,
          "end": 25.856,
          "text": "请把药师理解为宗教语境中的形象，而非替代医生的治疗承诺。"
        },
        {
          "start": 25.856,
          "end": 32.418,
          "text": "人们在此表达关怀与祝愿，现实中仍需接受合适医疗照护。"
        },
        {
          "start": 32.418,
          "end": 38.084,
          "text": "主题是东方三圣：药师佛与日光、月光二位菩萨。"
        },
        {
          "start": 38.084,
          "end": 43.696,
          "text": "中央主尊使构图稳定，两侧胁侍把光明意象展开。"
        },
        {
          "start": 43.696,
          "end": 50.937,
          "text": "日月不是用来预测个人命运的符号，而是表达遍照、清净等观念的方式。"
        },
        {
          "start": 50.937,
          "end": 59.239,
          "text": "观察三尊像的高低、手势和装束，在整体关系里辨认身份，不只是找某件法器。"
        },
        {
          "start": 59.239,
          "end": 63.016,
          "text": "琉璃光也不单形容亮闪闪的装饰。"
        },
        {
          "start": 63.016,
          "end": 66.984,
          "text": "寺院对名称的解释强调清净明澈。"
        },
        {
          "start": 66.984,
          "end": 76.821,
          "text": "古人在材料与光的经验中，寻找表达抽象观念的方法：清澈让人想到不被遮蔽，明亮让人想到方向。"
        },
        {
          "start": 76.821,
          "end": 86.44,
          "text": "即使不把它理解为个人信仰，也能明白为什么这样的名称，适合承载对疾病、困苦与不安的回应。"
        },
        {
          "start": 86.44,
          "end": 89.552,
          "text": "看造像时，比较衣褶处理。"
        },
        {
          "start": 89.552,
          "end": 95.34,
          "text": "主尊往往稳定，两侧菩萨的冠饰或衣带使画面丰富。"
        },
        {
          "start": 95.34,
          "end": 107.391,
          "text": "不急着把每种装饰解释成神秘功能，先看其构图作用：哪条线引导目光，哪块颜色突出中心，哪些重复形状形成节奏。"
        },
        {
          "start": 107.391,
          "end": 112.799,
          "text": "艺术之美不只有宏大高度，也有细小而有序的安排。"
        },
        {
          "start": 112.799,
          "end": 119.416,
          "text": "把目光从面孔移到衣缘，再回到三尊整体，会看见不一样的层次。"
        },
        {
          "start": 119.416,
          "end": 129.565,
          "text": "停留时，也可以想到旅行中的照护：同行的人是否累了，是否需要喝水，台阶会不会让膝盖不舒服。"
        },
        {
          "start": 129.565,
          "end": 136.739,
          "text": "把愿望落实到关心身边的人，比匆忙赶完全部殿堂更接近此处主题。"
        },
        {
          "start": 136.739,
          "end": 147.459,
          "text": "如果体力允许，再往后方华严殿；不想继续上阶，可以在此结束中轴参观，把最后一段当作坐着听的收尾。"
        },
        {
          "start": 147.459,
          "end": 151.916,
          "text": "旅行的充实，不需要用走过多少台阶证明。"
        }
      ]
    },
    {
      "id": "huayan",
      "name": "华严殿 · 在中轴尽头看见彼此相连",
      "src": "assets/audio/huayan.mp3",
      "duration": 159.144,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-8%",
      "pitch": "-2Hz",
      "synthetic": true,
      "script_sha256": "9cf003b7e839e2ec0a0ea49d5bac70fb1baa2e4291305fa5b422ea38f3d42965",
      "bytes": 954864,
      "sample_rate": 24000,
      "cues": [
        {
          "start": 0.1,
          "end": 3.08,
          "text": "来到中轴较高处的华严殿。"
        },
        {
          "start": 3.03,
          "end": 10.326,
          "text": "如果已经走累，可以在允许休息的地方听，不必为完成最后一个点继续爬阶。"
        },
        {
          "start": 10.326,
          "end": 19.212,
          "text": "寺院沿山势逐级展开，前后院落不是简单复制；走得越深，山林与屋顶关系也变化。"
        },
        {
          "start": 19.212,
          "end": 25.679,
          "text": "到这里回望，会发现中轴既安排建筑，也安排人的身体经验。"
        },
        {
          "start": 25.679,
          "end": 33.057,
          "text": "华严殿供奉华严三圣，中央是毗卢遮那佛，两侧文殊与普贤菩萨。"
        },
        {
          "start": 33.057,
          "end": 36.603,
          "text": "这里采用寺院中文资料中的名称。"
        },
        {
          "start": 36.603,
          "end": 46.97,
          "text": "文殊常与智慧相联系，普贤常与实践和行愿相联系；放在一起，可以理解为认识与行动互相支持。"
        },
        {
          "start": 46.97,
          "end": 53.519,
          "text": "不是知道许多名词便完成学习，也不是没有理解就匆忙行动。"
        },
        {
          "start": 53.519,
          "end": 59.769,
          "text": "这也适合今天参观：先看清楚，再决定如何对待眼前文化。"
        },
        {
          "start": 59.769,
          "end": 67.255,
          "text": "华严经是重要佛教经典，形成了关于世界彼此关联的丰富思想与图像。"
        },
        {
          "start": 67.255,
          "end": 85.856,
          "text": "普通游客无需几分钟掌握完整教义，可以从容易感受的经验入手：一座殿不只靠一尊像成立，还依赖建筑、工匠、维护者、僧众和来到这里的人；风景也不只靠一棵树、一条溪存在。"
        },
        {
          "start": 85.856,
          "end": 92.582,
          "text": "这样的比喻帮助理解关联性即可，不把它当成宗教教义的全部定义。"
        },
        {
          "start": 92.582,
          "end": 98.804,
          "text": "看三圣组合，先看中央与两侧的距离，再看装束、手势。"
        },
        {
          "start": 98.804,
          "end": 103.736,
          "text": "保持间隔，使三尊既成整体，又各自清楚。"
        },
        {
          "start": 103.736,
          "end": 108.927,
          "text": "殿内光线与背景，让这些关系被远处的人辨认。"
        },
        {
          "start": 108.927,
          "end": 116.128,
          "text": "若部分区域关闭，或正在宗教活动，就留在指定范围观看，调低音量。"
        },
        {
          "start": 116.128,
          "end": 123.872,
          "text": "空间意义也来自其中仍在进行的生活，尊重使用者比找到最佳镜头重要。"
        },
        {
          "start": 123.872,
          "end": 134.715,
          "text": "到这里，从天然岩石、古代题记与摩崖造像，走到历经修建的寺院中轴，我们看到不同材料保存的历史。"
        },
        {
          "start": 134.715,
          "end": 142.201,
          "text": "回想今天记得最清楚的细节，也许是一道石纹，也许是向下凝视的面容。"
        },
        {
          "start": 142.201,
          "end": 147.187,
          "text": "能准确说出看见什么，比记住一串殿名珍贵。"
        },
        {
          "start": 147.187,
          "end": 151.06,
          "text": "下行慢一点，留意台阶与来往的人。"
        },
        {
          "start": 151.06,
          "end": 159.062,
          "text": "把智慧落实为观察，把行动落实为尊重，可以成为灵隐之行安静完整的结尾。"
        }
      ]
    }
  ]
}