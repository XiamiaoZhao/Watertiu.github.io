{
  "id": "daxiong",
  "name": "大雄宝殿 · 樟木巨像与一座殿的尺度",
  "src": "assets/audio/daxiong.mp3",
  "duration": 151.128,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "4d75fcf8a85fc4b45384e293fd3f9e31b07e3388d321c8d8d4e83265da30afe2",
  "bytes": 906768,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 5.281,
      "text": "进入大雄宝殿前，先在庭院稍远处看完整屋顶。"
    },
    {
      "start": 5.231,
      "end": 12.147,
      "text": "檐口层层展开，角部向上挑起，使很大体量不至于像沉重的墙。"
    },
    {
      "start": 12.147,
      "end": 25.285,
      "text": "寺院公布殿高三十三点六米，但数字只告诉大小；真正让人感到庄严的，是柱列、檐口、台基与人的尺度一起形成的关系。"
    },
    {
      "start": 25.285,
      "end": 29.783,
      "text": "走近再看，刚才整体就被许多细节替代。"
    },
    {
      "start": 29.783,
      "end": 32.867,
      "text": "殿中主尊是释迦牟尼佛。"
    },
    {
      "start": 32.867,
      "end": 43.859,
      "text": "大型樟木造像与一九五三年修复灵隐时的创制有关，参考唐代佛教雕塑风格，由多块樟木雕刻镶接而成。"
    },
    {
      "start": 43.859,
      "end": 50.068,
      "text": "这里要分清：借鉴唐代风格，不等于这尊像就是唐代遗物。"
    },
    {
      "start": 50.068,
      "end": 59.389,
      "text": "它同样值得欣赏，因为体现近现代修复中艺术设计、传统匠作与大体量制作的协作能力。"
    },
    {
      "start": 59.389,
      "end": 63.723,
      "text": "面对巨像，先看整体姿态，再看面部。"
    },
    {
      "start": 63.723,
      "end": 73.614,
      "text": "头部微向前，身体端坐，衣纹在胸腹和腿部形成弧线，使高大形象仍能与下方的人建立关系。"
    },
    {
      "start": 73.614,
      "end": 84.022,
      "text": "若完全按平视小像的比例放大，从地面看未必自然，所以大型造像须考虑观者位置、光线和距离。"
    },
    {
      "start": 84.022,
      "end": 89.484,
      "text": "即使不知道每个构件怎样连接，也能感到这种观看设计。"
    },
    {
      "start": 89.484,
      "end": 97.174,
      "text": "多块木料组合成巨像，要先解决整体结构，再把接合关系融入统一造型。"
    },
    {
      "start": 97.174,
      "end": 102.88,
      "text": "表层彩绘或金色处理，使不同木块成为连续形象。"
    },
    {
      "start": 102.88,
      "end": 114.198,
      "text": "不需为了找接缝贴近、触摸或进入未开放区域；重要的是工艺如何服务完整视觉，而非把作品拆成材料清单。"
    },
    {
      "start": 114.198,
      "end": 119.307,
      "text": "退回稍远位置，衣纹与面部的关系反而更清楚。"
    },
    {
      "start": 119.307,
      "end": 125.503,
      "text": "殿前还有古老石塔等遗存，与现今主殿不一定属于同一年代。"
    },
    {
      "start": 125.503,
      "end": 131.984,
      "text": "看见统一院落就以为所有东西同时建成，是参观时常见的误会。"
    },
    {
      "start": 131.984,
      "end": 135.842,
      "text": "不同年代恰好可以在同一视野里相遇。"
    },
    {
      "start": 135.842,
      "end": 143.043,
      "text": "出殿再回望，先前让你惊叹的高度，已被面容、衣纹与构造细节填充。"
    },
    {
      "start": 143.043,
      "end": 151.046,
      "text": "接下来的药师殿，会把主题从宏大空间，转向关于健康、光明和照护的愿望。"
    }
  ]
}