{
  "id": "lengquan",
  "name": "冷泉溪与冷泉亭 · 听水也是读园林",
  "src": "assets/audio/lengquan.mp3",
  "duration": 147.624,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "380838f8ac922188d19a5b2acad125b48d72f7a9d48338dcee0e453de4c84d2b",
  "bytes": 885744,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 5.526,
      "text": "来到冷泉溪，先把耳机稍移开几秒，听真正的水声。"
    },
    {
      "start": 5.476,
      "end": 15.068,
      "text": "水碰到石头，发出不同于平静湖面的声音；树荫与潮湿空气，也使这里和城市街道明显不同。"
    },
    {
      "start": 15.068,
      "end": 24.266,
      "text": "冷泉并非只适合拍匾额的名字，身体感到的凉意、声音与光线，本来就是景观的重要部分。"
    },
    {
      "start": 24.266,
      "end": 31.345,
      "text": "溪流把飞来峰石壁与灵隐寺一侧分开，又通过桥与路将它们相连。"
    },
    {
      "start": 31.345,
      "end": 44.484,
      "text": "在可停留的位置，比较南岸岩壁与北侧寺院：一边是带洞穴、造像的山体，一边是整齐殿堂与院落，中间的水像柔软的过渡带。"
    },
    {
      "start": 44.484,
      "end": 50.258,
      "text": "不登山，也能在溪边读到自然形态与人工秩序的对照。"
    },
    {
      "start": 50.258,
      "end": 57.283,
      "text": "白居易写过冷泉亭，可见这里很早就是人们观看、停留和赞叹的地方。"
    },
    {
      "start": 57.283,
      "end": 65.122,
      "text": "不过今天的亭与岸线经历过变化，不能把眼前建筑不加区别地称为唐代原物。"
    },
    {
      "start": 65.122,
      "end": 69.851,
      "text": "更值得问的是：为什么历代人愿意在这里设亭？"
    },
    {
      "start": 69.851,
      "end": 78.505,
      "text": "亭不需占满空间，只给人一个有遮蔽的落脚点，便把水、山石与树林一起纳入视野。"
    },
    {
      "start": 78.505,
      "end": 81.318,
      "text": "沿溪还能看到元代造像。"
    },
    {
      "start": 81.318,
      "end": 89.443,
      "text": "灵隐管理处对冷泉亭南岸附近佛龛的介绍，指出其中有汉式阿弥陀佛形象。"
    },
    {
      "start": 89.443,
      "end": 100.054,
      "text": "飞来峰特别之处，正在于同一山体里，不同时代、不同样式的作品彼此接近，并非每尊都属同一种风格。"
    },
    {
      "start": 100.054,
      "end": 106.861,
      "text": "判断依赖标牌与研究资料，不宜看见宝冠就匆忙贴上笼统标签。"
    },
    {
      "start": 106.861,
      "end": 113.179,
      "text": "做个小练习：先看水，再看石壁造像，最后看枝条走向。"
    },
    {
      "start": 113.179,
      "end": 119.307,
      "text": "水横向流动，岩壁让目光向上，枝条又把视线伸到远处。"
    },
    {
      "start": 119.307,
      "end": 123.234,
      "text": "园林节奏常由这些方向共同形成。"
    },
    {
      "start": 123.234,
      "end": 131.413,
      "text": "雨后石面可能湿滑，脚下比镜头更重要；不越围栏，也不必拍全每处石刻。"
    },
    {
      "start": 131.413,
      "end": 137.5,
      "text": "试着记住水声里最清楚的一次起伏，再选一尊真正看懂的像。"
    },
    {
      "start": 137.5,
      "end": 142.704,
      "text": "带走声音与细节，比匆忙收集一串照片更丰富。"
    },
    {
      "start": 142.704,
      "end": 147.541,
      "text": "回到主步道，我们继续看那组最有亲切感的笑脸。"
    }
  ]
}