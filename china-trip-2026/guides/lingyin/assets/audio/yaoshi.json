{
  "id": "yaoshi",
  "name": "药师殿 · 琉璃光中的照护愿望",
  "src": "assets/audio/yaoshi.mp3",
  "duration": 152.016,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "cdb35b8c57755c94cd2c30258137c1612772d95fcc6ebdc4ec5bb5f129341e7c",
  "bytes": 912096,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 4.629,
      "text": "离开大雄宝殿沿中轴向后，来到药师殿。"
    },
    {
      "start": 4.579,
      "end": 10.72,
      "text": "与仰望巨像相比，这里可以把注意力放在造像组合和名称。"
    },
    {
      "start": 10.72,
      "end": 19.28,
      "text": "药师佛全称药师琉璃光如来，在汉传佛教中与离苦、安稳与健康愿望相联系。"
    },
    {
      "start": 19.28,
      "end": 25.856,
      "text": "请把药师理解为宗教语境中的形象，而非替代医生的治疗承诺。"
    },
    {
      "start": 25.856,
      "end": 32.418,
      "text": "人们在此表达关怀与祝愿，现实中仍需接受合适医疗照护。"
    },
    {
      "start": 32.418,
      "end": 38.084,
      "text": "主题是东方三圣：药师佛与日光、月光二位菩萨。"
    },
    {
      "start": 38.084,
      "end": 43.696,
      "text": "中央主尊使构图稳定，两侧胁侍把光明意象展开。"
    },
    {
      "start": 43.696,
      "end": 50.937,
      "text": "日月不是用来预测个人命运的符号，而是表达遍照、清净等观念的方式。"
    },
    {
      "start": 50.937,
      "end": 59.239,
      "text": "观察三尊像的高低、手势和装束，在整体关系里辨认身份，不只是找某件法器。"
    },
    {
      "start": 59.239,
      "end": 63.016,
      "text": "琉璃光也不单形容亮闪闪的装饰。"
    },
    {
      "start": 63.016,
      "end": 66.984,
      "text": "寺院对名称的解释强调清净明澈。"
    },
    {
      "start": 66.984,
      "end": 76.821,
      "text": "古人在材料与光的经验中，寻找表达抽象观念的方法：清澈让人想到不被遮蔽，明亮让人想到方向。"
    },
    {
      "start": 76.821,
      "end": 86.44,
      "text": "即使不把它理解为个人信仰，也能明白为什么这样的名称，适合承载对疾病、困苦与不安的回应。"
    },
    {
      "start": 86.44,
      "end": 89.552,
      "text": "看造像时，比较衣褶处理。"
    },
    {
      "start": 89.552,
      "end": 95.34,
      "text": "主尊往往稳定，两侧菩萨的冠饰或衣带使画面丰富。"
    },
    {
      "start": 95.34,
      "end": 107.391,
      "text": "不急着把每种装饰解释成神秘功能，先看其构图作用：哪条线引导目光，哪块颜色突出中心，哪些重复形状形成节奏。"
    },
    {
      "start": 107.391,
      "end": 112.799,
      "text": "艺术之美不只有宏大高度，也有细小而有序的安排。"
    },
    {
      "start": 112.799,
      "end": 119.416,
      "text": "把目光从面孔移到衣缘，再回到三尊整体，会看见不一样的层次。"
    },
    {
      "start": 119.416,
      "end": 129.565,
      "text": "停留时，也可以想到旅行中的照护：同行的人是否累了，是否需要喝水，台阶会不会让膝盖不舒服。"
    },
    {
      "start": 129.565,
      "end": 136.739,
      "text": "把愿望落实到关心身边的人，比匆忙赶完全部殿堂更接近此处主题。"
    },
    {
      "start": 136.739,
      "end": 147.459,
      "text": "如果体力允许，再往后方华严殿；不想继续上阶，可以在此结束中轴参观，把最后一段当作坐着听的收尾。"
    },
    {
      "start": 147.459,
      "end": 151.916,
      "text": "旅行的充实，不需要用走过多少台阶证明。"
    }
  ]
}