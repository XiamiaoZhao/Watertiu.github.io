{
  "id": "yuemiao",
  "name": "岳庙 · 从忠烈祠到墓园的历史回声",
  "src": "assets/audio/yuemiao.mp3",
  "duration": 186.144,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "4b9a86767498ad38bcf29dcca3b868446cd7287731e3c3da3f6e62d2c88683d3",
  "bytes": 1116864,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 4.452,
      "text": "来到岳庙，先看山门与正殿之间的中轴。"
    },
    {
      "start": 4.402,
      "end": 14.402,
      "text": "庭院把人引向忠烈祠，后面的纪念陈列和一侧墓区，又把参观分成讲述生平与凭吊两个部分。"
    },
    {
      "start": 14.402,
      "end": 18.016,
      "text": "这里纪念的是南宋抗金将领岳飞。"
    },
    {
      "start": 18.016,
      "end": 25.965,
      "text": "要读懂它，可以先记四个年份：一一四二、一一六二、一二二一和一七一五。"
    },
    {
      "start": 25.965,
      "end": 34.538,
      "text": "它们分别帮助我们分清个人遭遇、身后平反、功德寺形成与现存建筑的历史层次。"
    },
    {
      "start": 34.538,
      "end": 37.948,
      "text": "一一四二年，岳飞在临安被害。"
    },
    {
      "start": 37.948,
      "end": 46.046,
      "text": "一一六二年，宋孝宗即位后为他恢复名誉，遗骸改葬栖霞岭，岳云墓也在旁。"
    },
    {
      "start": 46.046,
      "end": 57.826,
      "text": "过了数十年，到一二二一年，墓旁智果寺成为褒忠衍福寺，作为功德寺延续祭祀，这才逐渐形成今天岳庙的基础。"
    },
    {
      "start": 57.826,
      "end": 65.272,
      "text": "墓与祠的出现并不同步，后代子孙与朝廷的选择，也参与了纪念地的形成。"
    },
    {
      "start": 65.272,
      "end": 75.625,
      "text": "杭州市文保资料把现存主要建筑联系到清康熙五十四年，也就是一七一五年的重建，之后又经历修缮。"
    },
    {
      "start": 75.625,
      "end": 81.916,
      "text": "因此，眼前清代风格的殿堂与南宋人物之间隔着几百年。"
    },
    {
      "start": 81.916,
      "end": 88.587,
      "text": "它们保存的不是岳飞曾经住过的房间，而是后人不断重申的评价。"
    },
    {
      "start": 88.587,
      "end": 94.959,
      "text": "忠烈祠、启忠祠以及墓园各有功能，不能都笼统地叫一座庙。"
    },
    {
      "start": 94.959,
      "end": 101.522,
      "text": "进入忠烈祠，正面可以留意心昭天日匾额，题字出自叶剑英。"
    },
    {
      "start": 101.522,
      "end": 106.889,
      "text": "它呼应关于岳飞临终以天日昭昭表明心迹的记述。"
    },
    {
      "start": 106.889,
      "end": 113.152,
      "text": "殿内有戎装岳飞坐像，周围壁画把其生平转成连续画面。"
    },
    {
      "start": 113.152,
      "end": 119.864,
      "text": "仰头看到的匾额、装饰与鸟纹，又把人物气节转化成视觉象征。"
    },
    {
      "start": 119.864,
      "end": 127.228,
      "text": "读这些形象时，可以问自己：这里是在讲一件史事，还是表达后人的赞颂？"
    },
    {
      "start": 127.228,
      "end": 130.149,
      "text": "两者相关，但并不相同。"
    },
    {
      "start": 130.149,
      "end": 136.726,
      "text": "移向墓区，岳飞与岳云两座墓提醒我们，这也是一个家庭的悲剧。"
    },
    {
      "start": 136.726,
      "end": 145.924,
      "text": "墓前甬道、石像生和碑廊让行进节奏变得庄重；碑刻保存了不同年代的人如何评价他。"
    },
    {
      "start": 145.924,
      "end": 150.503,
      "text": "相对的铁铸跪像则是后世设置的褒贬符号。"
    },
    {
      "start": 150.503,
      "end": 156.63,
      "text": "它们不是当年的现场再现，也不需要游客以拍打来重复惩罚。"
    },
    {
      "start": 156.63,
      "end": 163.193,
      "text": "岳母刺字的场景广为流传，戏曲和小说不断丰富其中细节。"
    },
    {
      "start": 163.193,
      "end": 172.989,
      "text": "把它当作表达尽责与报国的故事来听，同时把有明确年份和文献的历史另放一层，会让理解更扎实。"
    },
    {
      "start": 172.989,
      "end": 186.073,
      "text": "离开前，可以从忠烈祠回望庭院：今天人们走进来，不只是愤怒于冤屈，也是在思考责任、政治选择与一个人为何能被持续纪念。"
    }
  ]
}