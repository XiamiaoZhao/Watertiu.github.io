{
  "id": "duanqiao",
  "name": "断桥 · 一座不断的桥与两种记忆",
  "src": "assets/audio/duanqiao.mp3",
  "duration": 147.0,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "f64c05ee6f66a257e6cf569213a0d3fb6ebeff6da992e8605bd9783a65326d00",
  "bytes": 882000,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 5.526,
      "text": "现在请在断桥附近停下，先找一找桥的真正形状。"
    },
    {
      "start": 5.476,
      "end": 13.872,
      "text": "它并没有缺掉一截；从岸上看，桥面略微抬起，行人的身影沿着弧线缓缓移动。"
    },
    {
      "start": 13.872,
      "end": 20.38,
      "text": "桥在白堤东端，一边连着北山街，一边把我们送向湖中的长堤。"
    },
    {
      "start": 20.38,
      "end": 28.546,
      "text": "先望向白堤，再转身看北面的山，就不会只顾人群，忘了桥在整个湖面上的位置。"
    },
    {
      "start": 28.546,
      "end": 32.799,
      "text": "断桥这个名字，唐代诗歌中已经出现。"
    },
    {
      "start": 32.799,
      "end": 44.103,
      "text": "为什么叫断桥，流传着许多解释，其中一种与积雪有关：向阳一面的雪先消融，远看白色堤线仿佛在这里断开。"
    },
    {
      "start": 44.103,
      "end": 51.603,
      "text": "这种说法帮助人们理解断桥残雪的意境，却不能当作已经证明的命名过程。"
    },
    {
      "start": 51.603,
      "end": 60.747,
      "text": "没有雪，也仍能读懂它：同一座桥，会随着天气、光线和观看方向，变成不同的景色。"
    },
    {
      "start": 60.747,
      "end": 63.641,
      "text": "另一层记忆来自白蛇传。"
    },
    {
      "start": 63.641,
      "end": 73.03,
      "text": "白娘子和许仙的相遇、借伞，以及戏曲里动人的断桥一折，都让通行建筑变成了情感舞台。"
    },
    {
      "start": 73.03,
      "end": 79.062,
      "text": "但故事经历过长期演变，文学、戏曲和影视各有改写。"
    },
    {
      "start": 79.062,
      "end": 85.571,
      "text": "把它当作传说欣赏，比执着寻找人物真实站过的石板更有意思。"
    },
    {
      "start": 85.571,
      "end": 93.492,
      "text": "传说赋予地点情绪，历史告诉我们地点如何变化，两种观看方式可以并存。"
    },
    {
      "start": 93.492,
      "end": 97.962,
      "text": "换一个角度观察：低矮桥拱为什么适合这里？"
    },
    {
      "start": 97.962,
      "end": 104.103,
      "text": "因为它没有完全挡住水面，视线仍能越过桥看向远处。"
    },
    {
      "start": 104.103,
      "end": 112.391,
      "text": "桥上的人又让空阔的湖有了尺度；即使听不清声音，也能感到城市生活就在身边。"
    },
    {
      "start": 112.391,
      "end": 120.095,
      "text": "古人写景，往往不是把一切写满，而是在大片水色里留下一个小小的焦点。"
    },
    {
      "start": 120.095,
      "end": 125.611,
      "text": "拍照时，可以把桥放在画面一侧，让湖面保留空白。"
    },
    {
      "start": 125.611,
      "end": 130.842,
      "text": "不要在桥中央长时间停留，故事可以在岸边听完。"
    },
    {
      "start": 130.842,
      "end": 137.677,
      "text": "试着记录桥拱、树影和远山三个层次，照片便会多一点深度。"
    },
    {
      "start": 137.677,
      "end": 146.916,
      "text": "接下来沿白堤向西走，带着一个小问题：这条与白居易同姓的堤，真的就是他主持修筑的吗？"
    }
  ]
}