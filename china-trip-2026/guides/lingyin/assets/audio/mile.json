{
  "id": "mile",
  "name": "布袋弥勒 · 一张笑脸怎样进入石窟",
  "src": "assets/audio/mile.mp3",
  "duration": 148.608,
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "-8%",
  "pitch": "-2Hz",
  "synthetic": true,
  "script_sha256": "33ad4276c5cc03b42b1e6d967e026e3852b450ed7235abd685ba0e5eb46d6327",
  "bytes": 891648,
  "sample_rate": 24000,
  "cues": [
    {
      "start": 0.1,
      "end": 5.689,
      "text": "飞来峰最容易记住的形象之一，是露腹而笑的布袋弥勒。"
    },
    {
      "start": 5.639,
      "end": 11.59,
      "text": "在不挡人的位置，先完整看这组造像，再把视线移向两侧。"
    },
    {
      "start": 11.59,
      "end": 17.595,
      "text": "中央人物体量醒目，面部带笑，周围罗汉则有不同姿态。"
    },
    {
      "start": 17.595,
      "end": 27.296,
      "text": "这不是随意排满人物，而用中心与两侧、坐姿与动作的差异，组织一幅可慢慢读的石上群像。"
    },
    {
      "start": 27.296,
      "end": 33.573,
      "text": "日常的大肚笑佛，并非所有地区、所有时代弥勒的唯一模样。"
    },
    {
      "start": 33.573,
      "end": 42.622,
      "text": "弥勒还可呈现菩萨装等形象；布袋和尚式弥勒，与后世流传的契此和尚故事联系很深。"
    },
    {
      "start": 42.622,
      "end": 48.288,
      "text": "传说把亲切、洒脱、能容人的气质赋予宗教形象。"
    },
    {
      "start": 48.288,
      "end": 56.943,
      "text": "认出笑脸只是第一步，更深一层是看到一种信仰如何在本地文化里获得熟悉面孔。"
    },
    {
      "start": 56.943,
      "end": 63.111,
      "text": "看工艺，可以先看肚腹的大曲面，再看手指、衣缘和嘴角。"
    },
    {
      "start": 63.111,
      "end": 69.266,
      "text": "圆润大面形成明暗渐变，小而深的刻线制造清楚阴影。"
    },
    {
      "start": 69.266,
      "end": 75.516,
      "text": "两种处理放在一起，形象便既有整体安稳，也有生动表情。"
    },
    {
      "start": 75.516,
      "end": 85.788,
      "text": "与可移动木雕相比，摩崖造像还受岩石厚度和裂隙限制，雕刻者必须在材料允许范围里安排身体。"
    },
    {
      "start": 85.788,
      "end": 93.872,
      "text": "再看周围罗汉：有人转头，有人收拢肢体，有人的衣纹把动作延伸到身体之外。"
    },
    {
      "start": 93.872,
      "end": 100.408,
      "text": "群像趣味不只在脸是否不同，还在人物之间形成怎样的呼应。"
    },
    {
      "start": 100.408,
      "end": 106.671,
      "text": "任选两尊，比肩膀高低和头部方向，不必一次辨全姓名。"
    },
    {
      "start": 106.671,
      "end": 114.117,
      "text": "对于没有明确标识的细节，我们保留疑问，不凭想象编成确定的个人故事。"
    },
    {
      "start": 114.117,
      "end": 120.625,
      "text": "石面受到自然风化与长期保护措施影响，现场也可能有围护。"
    },
    {
      "start": 120.625,
      "end": 126.495,
      "text": "请不要把摸肚子、摸手等流行做法当成必须完成的习俗。"
    },
    {
      "start": 126.495,
      "end": 130.503,
      "text": "耐心观看才是真正接近作品的方法。"
    },
    {
      "start": 130.503,
      "end": 138.356,
      "text": "稍微换个角度，看看笑容是否随着阴影改变，就能体会雕刻留下的微妙空间。"
    },
    {
      "start": 138.356,
      "end": 148.533,
      "text": "离开后进入天王殿，还会见到与弥勒相关的形象；它所在的位置，与护法的关系，又将带来不同感受。"
    }
  ]
}